// Basic MVP Matrix Vertex Shader
uniform float4x4 u_MVPMatrix;
uniform float4 u_Tint;

struct VS_INPUT {
    float4 position : POSITION;
    float2 uv       : TEXCOORD0;
};

struct VS_OUTPUT {
    float4 position : POSITION;
    float2 uv       : TEXCOORD0;
    float4 color    : COLOR0;
};

VS_OUTPUT main(VS_INPUT input) {
    VS_OUTPUT output;
    output.position = mul(u_MVPMatrix, input.position);
    output.uv = input.uv;
    output.color = u_Tint;
    return output;
}
